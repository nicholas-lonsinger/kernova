<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App-identity entitlement the system uses to launch and identify the agent. A
	     provisioning profile normally injects it; the Debug config signs profile-less
	     (Manual), so we declare it explicitly, floating with whichever team
	     DEVELOPMENT_TEAM resolves to (derived per-developer by `make bootstrap`, #476)
	     rather than a hardcoded team. Release signs Manual with the "Kernova macOS Agent
	     Developer ID" profile, which injects the same value. The agent is intentionally
	     NOT sandboxed — it opens vsock. -->
	<key>com.apple.application-identifier</key>
	<string>$(DEVELOPMENT_TEAM).$(PRODUCT_BUNDLE_IDENTIFIER)</string>
</dict>
</plist>
