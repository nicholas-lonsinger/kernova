<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox, adopted for Mac App Store eligibility (#89). Host vsock is
	     fully framework-mediated — VZVirtioSocketListener/-Connection hand the
	     app already-connected fds and it never calls socket()/bind()/listen()
	     itself — so the sandbox does not constrain it (network entitlements gate
	     socket-acquisition syscalls, not I/O on granted fds). The serial-console
	     relay's AF_UNIX listener binds inside the app's own temp directory,
	     which file rules allow; network.server is deliberately absent (it gates
	     network-family listeners only). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Sole network use: fetching guest installer images and their metadata —
	     macOS restore images from Apple's CDN, Linux installer images from the
	     distributions' mirrors. The services that reach the network are
	     catalogued in docs/SANDBOX.md. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Powerbox grants from NSOpenPanel/NSSavePanel (external disk images,
	     ISOs, shared folders, Linux kernel/initrd, local IPSW files). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- The default IPSW download destination (~/Downloads/RestoreImage.ipsw)
	     and its sibling .kernovadownload resume sidecar. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- Panel grants persist across relaunches as app-scoped security
	     bookmarks (SecurityScopedBookmark). -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.virtualization</key>
	<true/>
	<!-- Guest networking beyond NAT: vmnet requires this entitlement for all
	     API use, and a bridged attachment fails VZ configuration validation
	     without it. A managed capability on the App ID — eligible provisioning
	     profiles carry it automatically. It is restricted: signing must be
	     authorized by such a profile, so the default build signs with
	     Kernova.Development.entitlements instead (this file minus this key —
	     keep the two in sync); see docs/BUILD.md "Signing identity". -->
	<key>com.apple.vm.networking</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Passing a host USB accessory through to a guest. The App Sandbox
	     profile keys on this entitlement directly: frameworks.sb grants the
	     AppleUSBHostDeviceUserClient/AppleUSBHostFrameworkDeviceClient IOKit
	     user clients to a process holding it. Xcode's capability catalog lists
	     it as "Claim USB Accessory", public and App Store-eligible, so enabling
	     it on the App ID takes no request to Apple — but it is restricted, like
	     com.apple.vm.networking above: amfid kills an ad-hoc-signed binary
	     claiming it ("adhoc signed but contains restricted entitlements"), so
	     the default build signs with Kernova.Development.entitlements, this
	     file minus both restricted keys. -->
	<key>com.apple.developer.accessory-access.usb</key>
	<true/>
	<!-- The container the app and its `kernova` command-line tool meet in,
	     holding the command socket. `$(TeamIdentifierPrefix)` is load-bearing —
	     docs/research/2026-09-05-cli-transport-launchd-domains-and-sandboxed-sockets.md
	     records what containermanagerd does without it. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)app.kernova</string>
	</array>
</dict>
</plist>
