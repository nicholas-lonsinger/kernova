<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">

<dictionary title="Kernova Terminology" xmlns:xi="http://www.w3.org/2001/XInclude">

	<xi:include href="file:///System/Library/ScriptingDefinitions/CocoaStandard.sdef" xpointer="xpointer(/dictionary/suite)"/>

	<suite name="Kernova Suite" code="Krnv" description="Classes and commands for controlling virtual machines.">

		<enumeration name="VM state" code="KvSE" description="What a virtual machine is doing right now.">
			<enumerator name="stopped" code="KsSt" description="Powered off."/>
			<enumerator name="starting" code="KsSg" description="Booting."/>
			<enumerator name="running" code="KsRn" description="The guest is up."/>
			<enumerator name="paused" code="KsPs" description="The guest is frozen in memory."/>
			<enumerator name="suspended" code="KsSu" description="The guest's state is saved to disk; resuming restores it."/>
			<enumerator name="saving" code="KsSv" description="Writing the guest's state to the bundle's suspend slot."/>
			<enumerator name="snapshotting" code="KsSn" description="Capturing a named restore point."/>
			<enumerator name="cloning" code="KsCl" description="Copying a running or paused guest into a new virtual machine."/>
			<enumerator name="restoring" code="KsRs" description="Reading a saved session or a restore point back."/>
			<enumerator name="installing" code="KsIn" description="Running the guest install."/>
			<enumerator name="initial boot" code="KsIb" description="In the library, but never booted."/>
			<enumerator name="failed" code="KsEr" description="The last operation left the VM in an error state."/>
			<enumerator name="preparing" code="KsPr" description="A create, clone or import is still writing the bundle."/>
		</enumeration>

		<enumeration name="VM stop method" code="KvSM" description="How a stop reaches a powered-off guest.">
			<enumerator name="shut down" code="KmSd" description="Ask the guest to power itself off."/>
			<enumerator name="force" code="KmFo" description="Terminate the virtual machine at once, losing unsaved guest state."/>
		</enumeration>

		<enumeration name="network kind" code="KvNK" description="The mode every virtual machine on a named network runs in.">
			<enumerator name="nat" code="KnSh" description="The guests reach the internet through this Mac."/>
			<enumerator name="host only" code="KnHo" description="The guests reach this Mac and each other, nothing else."/>
		</enumeration>

		<enumeration name="storage disk kind" code="KvDK" description="The bus the guest sees a storage disk on.">
			<enumerator name="virtio" code="KdVi" description="A virtio block device."/>
			<enumerator name="USB mass storage" code="KdUs" description="A USB mass storage device."/>
		</enumeration>

		<class-extension extends="application" description="Kernova's top-level scripting object.">
			<cocoa class="NSApplication"/>
			<element type="virtual machine" access="r" description="The virtual machines in the library.">
				<cocoa key="virtualMachines"/>
				<accessor style="index"/>
				<accessor style="name"/>
				<accessor style="id"/>
				<accessor style="range"/>
				<accessor style="test"/>
			</element>
			<element type="network" description="The library's named networks, ordered by name.">
				<cocoa key="networks"/>
				<accessor style="index"/>
				<accessor style="name"/>
				<accessor style="id"/>
				<accessor style="range"/>
				<accessor style="test"/>
			</element>
		</class-extension>

		<class name="virtual machine" code="KvVM" plural="virtual machines" description="One virtual machine in the library.">
			<cocoa class="VMScriptObject"/>
			<property name="id" code="ID  " type="text" access="r" description="Its stable identifier.">
				<cocoa key="uniqueID"/>
			</property>
			<property name="name" code="pnam" type="text" access="r" description="Its display name, which is not unique.">
				<cocoa key="name"/>
			</property>
			<property name="state" code="KvSt" type="VM state" access="r" description="What it is doing right now.">
				<cocoa key="state"/>
			</property>
			<property name="guest operating system" code="KvOS" type="text" access="r" description="Which guest it runs.">
				<cocoa key="guestOperatingSystem"/>
			</property>
			<property name="processor count" code="KvCP" type="integer" access="r" description="Virtual CPU cores the guest is configured with.">
				<cocoa key="processorCount"/>
			</property>
			<property name="memory" code="KvMm" type="real" access="r" description="Guest memory in gigabytes.">
				<cocoa key="memory"/>
			</property>
			<property name="network mode" code="KvNm" type="text" description="The network it joins, or missing value when networking is off. Set it to nat, bridged or hostOnly, or to none to turn networking off.">
				<cocoa key="networkMode"/>
			</property>
			<property name="network membership" code="KvMb" type="text" description="Which network of its mode it joins: common, the one every other virtual machine in the mode joins, isolated, a network of its own, or the identifier of a named network; missing value when it joins no NAT or Host Only network. Set it to common, isolated, or a named network&#8217;s name or identifier.">
				<cocoa key="networkMembership"/>
			</property>
			<property name="network name" code="KvNa" type="text" access="r" description="The name of the named network it joins, &#8220;Network List Can&#8217;t Be Read&#8221; while this library&#8217;s list of networks can&#8217;t be read, or missing value when it joins none or one this library does not list.">
				<cocoa key="networkName"/>
			</property>
			<property name="MAC address" code="KvMA" type="text" description="The address the guest presents on that network. Set it to six colon-separated hex pairs, or to new for a fresh address.">
				<cocoa key="macAddress"/>
			</property>
			<property name="IP address" code="KvIP" type="text" access="r" description="The address Kernova last saw the guest use on its network, or missing value when it has seen none.">
				<cocoa key="ipAddress"/>
			</property>
			<property name="agent status" code="KvAg" type="text" access="r" description="The guest agent's install and connectivity state, or missing value when Kernova has no channel to the agent, such as while the virtual machine is stopped or suspended.">
				<cocoa key="agentStatus"/>
			</property>
			<property name="has saved state" code="KvSs" type="boolean" access="r" description="Whether the bundle holds a suspended session.">
				<cocoa key="hasSavedState"/>
			</property>
			<property name="ephemeral" code="KvEp" type="boolean" access="r" description="Whether it returns to a baseline snapshot on every power-off.">
				<cocoa key="ephemeral"/>
			</property>
			<property name="snapshot count" code="KvSc" type="integer" access="r" description="How many named restore points the bundle holds.">
				<cocoa key="snapshotCount"/>
			</property>
			<property name="bundle path" code="KvBp" type="text" access="r" description="Where its bundle lives.">
				<cocoa key="bundlePath"/>
			</property>
			<element type="storage disk" access="r" description="The disks it attaches, in the order it attaches them.">
				<cocoa key="storageDisks"/>
				<accessor style="index"/>
				<accessor style="name"/>
				<accessor style="id"/>
				<accessor style="range"/>
				<accessor style="test"/>
			</element>
		</class>

		<class name="storage disk" code="KvSD" plural="storage disks" description="A disk a virtual machine attaches. Its sizes are measured from its image file each time a script reads them.">
			<cocoa class="VMStorageDiskScriptObject"/>
			<property name="id" code="ID  " type="text" access="r" description="Its stable identifier, which a storage disk edit names it by.">
				<cocoa key="uniqueID"/>
			</property>
			<property name="name" code="pnam" type="text" access="r" description="Its label.">
				<cocoa key="name"/>
			</property>
			<property name="kind" code="KvKd" type="storage disk kind" access="r" description="The bus the guest sees it on.">
				<cocoa key="kind"/>
			</property>
			<property name="read only" code="KvRo" type="boolean" access="r" description="Whether the guest may read it but not write to it.">
				<cocoa key="readOnly"/>
			</property>
			<property name="path" code="KvPa" type="text" access="r" description="Its image file, as this Mac names it.">
				<cocoa key="path"/>
			</property>
			<property name="notes" code="KvNo" type="text" access="r" description="The user&#8217;s note on it, empty when there is none.">
				<cocoa key="notes"/>
			</property>
			<property name="capacity" code="KvCa" type="real" access="r" description="Its size as the guest sees it, in gigabytes of 10^9 bytes, or missing value when its image can&#8217;t be read.">
				<cocoa key="capacity"/>
			</property>
			<property name="used space" code="KvUs" type="real" access="r" description="What its image takes on its volume, in gigabytes of 10^9 bytes, or missing value when its image can&#8217;t be read.">
				<cocoa key="usedSpace"/>
			</property>
		</class>

		<class name="network" code="KvNw" plural="networks" description="A named network: the virtual machines on it reach each other, and no other guest. Make one with make new network with properties {name:…, kind:…}, a NAT network unless kind names another. Deleting one is refused while a virtual machine is set to join it; setting that machine's network membership to isolated moves it to a network of its own.">
			<cocoa class="VMNetworkScriptObject"/>
			<property name="id" code="ID  " type="text" access="r" description="Its stable identifier, which a virtual machine's network membership names.">
				<cocoa key="uniqueID"/>
			</property>
			<property name="name" code="pnam" type="text" description="Its name, unique in the library ignoring case.">
				<cocoa key="name"/>
			</property>
			<property name="kind" code="KvKd" type="network kind" access="r" description="The mode every virtual machine on it runs in, fixed when it is made.">
				<cocoa key="kind"/>
			</property>
			<element type="virtual machine" access="r" description="The virtual machines that join it.">
				<cocoa key="virtualMachines"/>
			</element>
		</class>

		<command name="start" code="KrnvStrt" description="Start a virtual machine, running whatever guest setup it still owes first.">
			<cocoa class="VMStartScriptCommand"/>
			<direct-parameter description="The virtual machine to start, or a list of them.">
				<type type="virtual machine"/>
				<type type="virtual machine" list="yes"/>
			</direct-parameter>
			<parameter name="recovery mode" code="Kprc" type="boolean" optional="yes" description="Cold-boot a stopped macOS guest into macOS Recovery.">
				<cocoa key="RecoveryMode"/>
			</parameter>
			<parameter name="confirmation" code="Kpcf" type="boolean" optional="yes" description="Start it beside an active virtual machine with the same machine ID, where Kernova's Settings allow starting one anyway.">
				<cocoa key="Confirmation"/>
			</parameter>
		</command>

		<command name="stop" code="KrnvStop" description="Stop a virtual machine. Wrap a long wait in a with timeout block: AppleScript gives up on a reply after two minutes by default.">
			<cocoa class="VMStopScriptCommand"/>
			<direct-parameter description="The virtual machine to stop, or a list of them.">
				<type type="virtual machine"/>
				<type type="virtual machine" list="yes"/>
			</direct-parameter>
			<parameter name="by" code="by  " type="VM stop method" optional="yes" description="How to reach a powered-off guest. Shut down by default.">
				<cocoa key="StopMethod"/>
			</parameter>
			<parameter name="confirmation" code="Kpcf" type="boolean" optional="yes" description="Supply the consent a destructive stop refuses without.">
				<cocoa key="Confirmation"/>
			</parameter>
			<parameter name="giving up after" code="givu" type="integer" optional="yes" description="Seconds to wait for the guest to power off before giving up and leaving it as it was.">
				<cocoa key="GivingUpAfter"/>
			</parameter>
		</command>

		<command name="restart" code="KrnvRstr" description="Shut a virtual machine's guest down and start it again. Wrap a long wait in a with timeout block: AppleScript gives up on a reply after two minutes by default.">
			<cocoa class="VMRestartScriptCommand"/>
			<direct-parameter description="The virtual machine to restart, or a list of them.">
				<type type="virtual machine"/>
				<type type="virtual machine" list="yes"/>
			</direct-parameter>
			<parameter name="confirmation" code="Kpcf" type="boolean" optional="yes" description="Start it again beside an active virtual machine with the same machine ID, where Kernova's Settings allow starting one anyway.">
				<cocoa key="Confirmation"/>
			</parameter>
			<parameter name="giving up after" code="givu" type="integer" optional="yes" description="Seconds to wait for the guest to power off before giving up and starting nothing.">
				<cocoa key="GivingUpAfter"/>
			</parameter>
		</command>

		<command name="pause" code="KrnvPaus" description="Freeze a running guest in memory.">
			<cocoa class="VMPauseScriptCommand"/>
			<direct-parameter description="The virtual machine to pause, or a list of them.">
				<type type="virtual machine"/>
				<type type="virtual machine" list="yes"/>
			</direct-parameter>
		</command>

		<command name="resume" code="KrnvResu" description="Run a paused guest again, or read a suspended session back.">
			<cocoa class="VMResumeScriptCommand"/>
			<direct-parameter description="The virtual machine to resume, or a list of them.">
				<type type="virtual machine"/>
				<type type="virtual machine" list="yes"/>
			</direct-parameter>
			<parameter name="confirmation" code="Kpcf" type="boolean" optional="yes" description="Resume it beside an active virtual machine with the same machine ID, where Kernova's Settings allow starting one anyway.">
				<cocoa key="Confirmation"/>
			</parameter>
		</command>

		<command name="suspend" code="KrnvSusp" description="Save the guest's state to the bundle's suspend slot and stop running it.">
			<cocoa class="VMSuspendScriptCommand"/>
			<direct-parameter description="The virtual machine to suspend, or a list of them.">
				<type type="virtual machine"/>
				<type type="virtual machine" list="yes"/>
			</direct-parameter>
		</command>

		<command name="reveal" code="KrnvRevl" description="Bring a virtual machine in front of the user, whatever state it is in.">
			<cocoa class="VMRevealScriptCommand"/>
			<direct-parameter description="The virtual machine to reveal, or a list of them.">
				<type type="virtual machine"/>
				<type type="virtual machine" list="yes"/>
			</direct-parameter>
		</command>

	</suite>

</dictionary>
