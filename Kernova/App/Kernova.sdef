<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">

<dictionary title="Kernova Terminology" xmlns:xi="http://www.w3.org/2001/XInclude">

	<suite name="Standard Suite" code="????" description="Common classes and commands for all applications.">

		<xi:include href="file:///System/Library/ScriptingDefinitions/CocoaStandard.sdef" xpointer="xpointer(/dictionary/suite/node()[not(self::command and (@name = 'delete' or @name = 'duplicate' or @name = 'make'))])"/>

		<!-- The Standard Suite's delete, taking a list of references too, the consent deleting a virtual machine or a snapshot refuses without, and a virtual machine's delete past the Trash, with the class that deletes both by what their references evaluate to. -->
		<command name="delete" code="coredelo" description="Delete an object. A virtual machine&#8217;s bundle moves to the Trash, and files it uses outside its bundle stay where they are. Deleting a shared directory stops sharing its folder, and deleting a remembered USB accessory forgets it; neither deletes a file. A delete naming several stops at the first one refused, leaving those before it deleted.">
			<cocoa class="VMDeleteScriptCommand"/>
			<access-group identifier="*"/>
			<direct-parameter description="The object(s) to delete.">
				<type type="specifier"/>
				<type type="specifier" list="yes"/>
			</direct-parameter>
			<parameter name="confirmation" code="Kpcf" type="boolean" optional="yes" description="Supply the consent deleting a virtual machine or a snapshot refuses without.">
				<cocoa key="Confirmation"/>
			</parameter>
			<parameter name="immediate deletion" code="KpIm" type="boolean" optional="yes" description="Delete a virtual machine&#8217;s bundle immediately, bypassing the Trash.">
				<cocoa key="ImmediateDeletion"/>
			</parameter>
		</command>

		<!-- The Standard Suite's duplicate, taking what a clone is of its source and whether to wait for its copy, with the class that clones a virtual machine and answers the clone. -->
		<command name="duplicate" code="coreclon" description="Copy an object. A virtual machine&#8217;s copy is a new virtual machine in the library, answered once its copy has finished; a reference to several answers a list, and stops at the first one refused. AppleScript stops waiting for an answer after two minutes unless a with timeout block gives it longer, and the copy goes on in Kernova.">
			<cocoa class="VMDuplicateScriptCommand"/>
			<access-group identifier="*"/>
			<direct-parameter type="specifier" requires-access="r" description="The object(s) to copy."/>
			<parameter name="to" code="insh" type="location specifier" description="The location for the new copy or copies." optional="yes">
				<cocoa key="ToLocation"/>
			</parameter>
			<parameter name="with properties" code="prdt" type="record" description="Properties to set in the new copy or copies right away." optional="yes">
				<cocoa key="WithProperties"/>
			</parameter>
			<parameter name="as" code="KpCo" type="clone outcome" optional="yes" description="What a virtual machine&#8217;s clone is of its source; without it, Clone as in Kernova&#8217;s Advanced settings decides.">
				<cocoa key="CloneOutcome"/>
			</parameter>
			<parameter name="waiting" code="KpWt" type="boolean" optional="yes" description="Wait for a virtual machine&#8217;s copy to finish before answering, as by default; without waiting answers the new virtual machine while its copy is still being written.">
				<cocoa key="Waiting"/>
			</parameter>
			<result description="The new virtual machine, or a list of them for a reference to several.">
				<type type="specifier"/>
				<type type="specifier" list="yes"/>
			</result>
		</command>

		<!-- The Standard Suite's make, with the class that takes a snapshot for one made at a virtual machine. -->
		<command name="make" code="corecrel" description="Create a new object.">
			<cocoa class="VMCreateScriptCommand"/>
			<access-group identifier="*"/>
			<parameter name="new" code="kocl" type="type" description="The class of the new object.">
				<cocoa key="ObjectClass"/>
			</parameter>
			<parameter name="at" code="insh" type="location specifier" optional="yes" description="The location at which to insert the object.">
				<cocoa key="Location"/>
			</parameter>
			<parameter name="with data" code="data" type="any" optional="yes" description="The initial contents of the object.">
				<cocoa key="ObjectData"/>
			</parameter>
			<parameter name="with properties" code="prdt" type="record" optional="yes" description="The initial values for properties of the object.">
				<cocoa key="KeyDictionary"/>
			</parameter>
			<result type="specifier" description="The new object."/>
		</command>

	</suite>

	<suite name="Kernova Suite" code="Krnv" description="Classes and commands for controlling virtual machines.">

		<enumeration name="VM state" code="KvSE" description="What a virtual machine is doing right now.">
			<enumerator name="stopped" code="KsSt" description="Powered off."/>
			<enumerator name="starting" code="KsSg" description="Booting."/>
			<enumerator name="running" code="KsRn" description="The guest is up."/>
			<enumerator name="paused" code="KsPs" description="The guest is frozen in memory."/>
			<enumerator name="suspended" code="KsSu" description="The guest's state is saved to disk; resuming restores it."/>
			<enumerator name="saving" code="KsSv" description="Writing the guest's state to the bundle's suspend slot."/>
			<enumerator name="snapshotting" code="KsSn" description="Capturing a named restore point."/>
			<enumerator name="cloning" code="KsCl" description="Copying a running or paused guest into a new virtual machine."/>
			<enumerator name="restoring" code="KsRs" description="Reading a saved session or a restore point back."/>
			<enumerator name="installing" code="KsIn" description="Running the guest install."/>
			<enumerator name="force stopping" code="KsFs" description="A force stop was sent and the virtual machine’s process has not ended yet."/>
			<enumerator name="initial boot" code="KsIb" description="In the library, but never booted."/>
			<enumerator name="failed" code="KsEr" description="The last operation left the VM in an error state."/>
			<enumerator name="preparing" code="KsPr" description="A create, clone or import is still writing the bundle."/>
		</enumeration>

		<enumeration name="VM state group" code="KvGE" description="A virtual machine&#8217;s coarse state, as the library&#8217;s filter groups it. A group spelled like a VM state is that state&#8217;s constant.">
			<enumerator name="running" code="KsRn" description="A session is live in this copy of Kernova, paused or mid-operation included."/>
			<enumerator name="suspended" code="KsSu" description="At rest with a saved session it resumes from."/>
			<enumerator name="stopped" code="KsSt" description="At rest with no session, never booted and failed included."/>
			<enumerator name="held by another copy" code="KsHc" description="Another running copy of Kernova holds it, and this copy can&#8217;t see its state."/>
			<enumerator name="preparing" code="KsPr" description="A create, clone or import is still writing its bundle."/>
		</enumeration>

		<enumeration name="VM stop method" code="KvSM" description="How a stop, or a restart, takes the guest down: the Virtual Machine menu’s Stop, Stop Anyway and Force Stop.">
			<enumerator name="normal" code="KmNo" description="Stop, or Restart: ask the guest to power itself off."/>
			<enumerator name="anyway" code="KmSa" description="Stop Anyway, or Restart Anyway: shut a macOS guest down without waiting for apps, which quit without asking to save. Takes the Kernova agent installed “For everyone”, connected."/>
			<enumerator name="force" code="KmFo" description="Force Stop, or Force Restart: terminate the virtual machine at once, losing anything in the guest that isn’t saved to disk."/>
		</enumeration>

		<enumeration name="network kind" code="KvNK" description="The mode every virtual machine on a named network runs in.">
			<enumerator name="nat" code="KnSh" description="The guests reach the internet through this Mac."/>
			<enumerator name="host only" code="KnHo" description="The guests reach this Mac and each other, nothing else."/>
		</enumeration>

		<enumeration name="VM network mode" code="KvNE" description="The mode of the network a virtual machine joins. A mode spelled like a network kind is that kind&#8217;s constant.">
			<enumerator name="nat" code="KnSh" description="Outbound access through this Mac, on a private subnet other machines on your network can&#8217;t reach."/>
			<enumerator name="bridged" code="KnBr" description="Attached to a network one of this Mac&#8217;s interfaces is on."/>
			<enumerator name="host only" code="KnHo" description="A private network shared with this Mac and other host only guests, with no access to your network or the internet."/>
		</enumeration>

		<enumeration name="storage disk kind" code="KvDK" description="The bus the guest sees a storage disk on.">
			<enumerator name="virtio" code="KdVi" description="A virtio block device."/>
			<enumerator name="USB mass storage" code="KdUs" description="A USB mass storage device."/>
		</enumeration>

		<enumeration name="snapshot kind" code="KvSK" description="What a snapshot captured.">
			<enumerator name="warm" code="KkWa" description="Its disks and settings, and the guest&#8217;s memory."/>
			<enumerator name="cold" code="KkCo" description="Its disks and settings, without the guest&#8217;s memory."/>
		</enumeration>

		<enumeration name="clone outcome" code="KvCO" description="What a virtual machine&#8217;s clone is of its source.">
			<enumerator name="new machine" code="KcNm" description="A virtual machine of its own: a new machine identity and MAC address, so both can run at once, with no snapshots and Ephemeral Mode off. Not offered for a guest running macOS 12 or earlier."/>
			<enumerator name="exact copy" code="KcEx" description="The source&#8217;s machine identity and MAC address, its snapshots, Ephemeral Mode and display preferences. The two run at once only when one is started anyway."/>
		</enumeration>

		<class-extension extends="application" description="Kernova’s top-level scripting object.">
			<cocoa class="NSApplication"/>
			<element type="virtual machine" access="r" description="The virtual machines in the library.">
				<cocoa key="virtualMachines"/>
				<accessor style="index"/>
				<accessor style="name"/>
				<accessor style="id"/>
				<accessor style="range"/>
				<accessor style="test"/>
			</element>
			<element type="network" description="The library's named networks, ordered by name.">
				<cocoa key="networks"/>
				<accessor style="index"/>
				<accessor style="name"/>
				<accessor style="id"/>
				<accessor style="range"/>
				<accessor style="test"/>
			</element>
			<element type="smart group" access="r" description="The library's smart groups, in the order the sidebar lists them.">
				<cocoa key="smartGroups"/>
				<accessor style="index"/>
				<accessor style="name"/>
				<accessor style="id"/>
				<accessor style="range"/>
				<accessor style="test"/>
			</element>
			<element type="folder" access="r" description="The library's folders, in the order the sidebar lists them.">
				<cocoa key="folders"/>
				<accessor style="index"/>
				<accessor style="name"/>
				<accessor style="id"/>
				<accessor style="range"/>
				<accessor style="test"/>
			</element>
			<element type="USB accessory" access="r" description="The USB accessories you&#8217;ve assigned to Kernova in macOS&#8217;s Virtual Machine Accessories menu extra that no virtual machine holds: the ones attach takes. USB accessory &#8220;&#8230;&#8221; names one by its id or its name, and refuses a name several of them carry, listing their ids.">
				<cocoa key="usbAccessories"/>
				<accessor style="index"/>
				<accessor style="name"/>
				<accessor style="id"/>
				<accessor style="range"/>
				<accessor style="test"/>
			</element>
		</class-extension>

		<class name="virtual machine" code="KvVM" plural="virtual machines" description="One virtual machine in the library.">
			<cocoa class="VMScriptObject"/>
			<property name="id" code="ID  " type="text" access="r" description="Its stable identifier.">
				<cocoa key="uniqueID"/>
			</property>
			<property name="name" code="pnam" type="text" description="Its display name, which another virtual machine can share. Setting it renames it.">
				<cocoa key="name"/>
			</property>
			<property name="state" code="KvSt" type="VM state" access="r" description="What it is doing right now.">
				<cocoa key="state"/>
			</property>
			<property name="state group" code="KvSg" type="VM state group" access="r" description="Its coarse state, as the library&#8217;s filter groups it; held by another copy when Kernova last found another running copy of Kernova holding it.">
				<cocoa key="stateGroup"/>
			</property>
			<property name="guest operating system" code="KvOS" type="text" access="r" description="Which guest it runs.">
				<cocoa key="guestOperatingSystem"/>
			</property>
			<property name="processor count" code="KvCP" type="integer" access="r" description="Virtual CPU cores the guest is configured with. Its setting &quot;cpus&quot; changes it.">
				<cocoa key="processorCount"/>
			</property>
			<property name="memory" code="KvMm" type="real" access="r" description="Guest memory in gigabytes. Its setting &quot;memory&quot; changes it.">
				<cocoa key="memory"/>
			</property>
			<property name="network mode" code="KvNm" type="VM network mode" access="r" description="The mode of the network it joins, or missing value when networking is off. Its setting &quot;network.mode&quot; changes it.">
				<cocoa key="networkMode"/>
			</property>
			<property name="network membership" code="KvMb" type="text" access="r" description="Which network of its mode it joins: &quot;common&quot;, the one every other virtual machine in the mode joins, &quot;isolated&quot;, a network of its own, or the identifier of a named network; missing value when it joins no NAT or Host Only network. Its setting &quot;network.membership&quot; changes it.">
				<cocoa key="networkMembership"/>
			</property>
			<property name="network name" code="KvNa" type="text" access="r" description="The name of the named network it joins, &#8220;Network List Can&#8217;t Be Read&#8221; while this library&#8217;s list of networks can&#8217;t be read, or missing value when it joins none or one this library does not list.">
				<cocoa key="networkName"/>
			</property>
			<property name="MAC address" code="KvMA" type="text" access="r" description="The address the guest presents on that network. Its setting &quot;network.mac&quot; changes it.">
				<cocoa key="macAddress"/>
			</property>
			<property name="IP address" code="KvIP" type="text" access="r" description="The address Kernova last saw the guest use on its network, or missing value when it has seen none.">
				<cocoa key="ipAddress"/>
			</property>
			<property name="agent status" code="KvAg" type="text" access="r" description="The guest agent's install and connectivity state, or missing value when Kernova has no channel to the agent, such as while the virtual machine is stopped or suspended.">
				<cocoa key="agentStatus"/>
			</property>
			<property name="agent version" code="KvAv" type="text" access="r" description="How the guest agents it last reached stand against the ones Kernova bundles: upToDate, olderVersion, or neverConnected; missing value when one has connected and Kernova bundles none for its guest to compare against.">
				<cocoa key="agentVersion"/>
			</property>
			<property name="has saved state" code="KvSs" type="boolean" access="r" description="Whether the bundle holds a suspended session.">
				<cocoa key="hasSavedState"/>
			</property>
			<property name="saved state version" code="KvSb" type="text" access="r" description="The Kernova version and build that wrote its saved state, such as 0.10.0 (412), or missing value when the bundle holds none or one saved before Kernova recorded its version.">
				<cocoa key="savedStateVersion"/>
			</property>
			<property name="ephemeral" code="KvEp" type="boolean" access="r" description="Whether it returns to a baseline snapshot every time it shuts down. A restart keeps its session. Its settings &quot;ephemeral&quot; and &quot;ephemeral.baseline&quot; change it.">
				<cocoa key="ephemeral"/>
			</property>
			<property name="snapshot count" code="KvSc" type="integer" access="r" description="How many named restore points the bundle holds.">
				<cocoa key="snapshotCount"/>
			</property>
			<property name="has snapshots" code="KvHs" type="boolean" access="r" description="Whether the bundle holds any snapshot; for a virtual machine a clone or import is still writing, whose snapshot count is 0, whether its source does.">
				<cocoa key="hasSnapshots"/>
			</property>
			<property name="tags" code="KvTg" access="r" description="The names of the tags it carries, in the order Kernova lists its tags, or missing value while Kernova can&#8217;t read its tags.">
				<cocoa key="tags"/>
				<type type="text" list="yes"/>
			</property>
			<property name="creation date" code="ascd" type="date" access="r" description="When it was created.">
				<cocoa key="creationDate"/>
			</property>
			<property name="last run date" code="KvLr" type="date" access="r" description="The last moment Kernova recorded it running, written as a session settles running and again as it ends, or missing value when no run is recorded.">
				<cocoa key="lastRunDate"/>
			</property>
			<property name="bundle path" code="KvBp" type="text" access="r" description="Where its bundle lives.">
				<cocoa key="bundlePath"/>
			</property>
			<element type="storage disk" access="r" description="The disks it attaches, in the order it attaches them.">
				<cocoa key="storageDisks"/>
				<accessor style="index"/>
				<accessor style="name"/>
				<accessor style="id"/>
				<accessor style="range"/>
				<accessor style="test"/>
			</element>
			<element type="guest agent" access="r" description="The guest agents Virtual Machine &#9656; Guest Agent Status lists for it, in that order; none while Kernova has no channel to them, such as while it is stopped or suspended.">
				<cocoa key="guestAgents"/>
				<accessor style="index"/>
				<accessor style="range"/>
				<accessor style="test"/>
			</element>
			<element type="snapshot" description="Its snapshots, newest first. Several can share a name: snapshot &#8220;&#8230;&#8221; refuses one more than one of them carries, listing their ids.">
				<cocoa key="snapshots"/>
				<accessor style="index"/>
				<accessor style="name"/>
				<accessor style="id"/>
				<accessor style="range"/>
				<accessor style="test"/>
			</element>
			<element type="setting" access="r" description="Its settings, named by key: every setting its guest has, in one order for every virtual machine. A setting its guest doesn&#8217;t have isn&#8217;t listed, and naming one is refused.">
				<cocoa key="settings"/>
				<accessor style="index"/>
				<accessor style="name"/>
				<accessor style="range"/>
				<accessor style="test"/>
			</element>
			<element type="shared directory" description="The folders it shares with its guest, in the order it shares them. Shared directory &#8220;&#8230;&#8221; names one by its folder&#8217;s full path, starting with / or ~/, or by its folder&#8217;s name, and refuses a name several of them carry, listing their paths.">
				<cocoa key="sharedDirectories"/>
				<accessor style="index"/>
				<accessor style="name"/>
				<accessor style="range"/>
				<accessor style="test"/>
			</element>
			<element type="USB accessory" access="r" description="The USB accessories its guest holds: the ones detach takes back. USB accessory &#8220;&#8230;&#8221; names one by its id or its name, and refuses a name several of them carry, listing their ids.">
				<cocoa key="usbAccessories"/>
				<accessor style="index"/>
				<accessor style="name"/>
				<accessor style="id"/>
				<accessor style="range"/>
				<accessor style="test"/>
			</element>
			<element type="remembered USB accessory" description="The USB accessories it takes back automatically, plugged in or not. Remembered USB accessory &#8220;&#8230;&#8221; names one by its key or its name, and refuses a name several of them carry, listing their keys.">
				<cocoa key="rememberedUSBAccessories"/>
				<accessor style="index"/>
				<accessor style="name"/>
				<accessor style="range"/>
				<accessor style="test"/>
			</element>
		</class>

		<class name="setting" code="KvCf" plural="settings" description="One of a virtual machine&#8217;s settings, such as setting &quot;cpus&quot; or setting &quot;display.width&quot;. On a virtual machine in Ephemeral Mode, a change to most of them goes back to its baseline snapshot at the next shutdown.">
			<cocoa class="VMSettingScriptObject"/>
			<property name="name" code="pnam" type="text" access="r" description="Its key.">
				<cocoa key="name"/>
			</property>
			<property name="value" code="valL" type="any" description="What it holds, of the type the setting takes: true or false; an integer; a real number of gigabytes, for &quot;memory&quot;; nat, bridged or host only, or missing value for no network, for &quot;network.mode&quot;; or text. It compares as that type does, in a whose test too, except that a whose test is false for two values of different types, which an if may first convert, and for true, false or a constant ordered, which an if stops at: value of setting &quot;cpus&quot; &lt; &quot;5&quot; is true in an if and false in a whose test. A whose test also ignores case in text within considering case. A value read and set back changes nothing, and any setting also takes text spelled as its summary spells its values. Setting it is refused for a change that asks for consent first, such as turning on Ephemeral Mode; change &#8230; with confirmation makes that change.">
				<cocoa key="value"/>
			</property>
			<property name="summary" code="KvSy" type="text" access="r" description="What it holds and the values it takes, in one line.">
				<cocoa key="summary"/>
			</property>
		</class>

		<class name="snapshot" code="KvSn" plural="snapshots" description="A virtual machine&#8217;s named restore point. Take one with make new snapshot at a virtual machine, with properties {name:&#8230;, notes:&#8230;}; with no name, Kernova names it Snapshot, then Snapshot 2, and so on. Its sizes are measured from its files each time a script reads them.">
			<cocoa class="VMSnapshotScriptObject"/>
			<property name="id" code="ID  " type="text" access="r" description="Its stable identifier, unique among its virtual machine&#8217;s snapshots.">
				<cocoa key="uniqueID"/>
			</property>
			<property name="name" code="pnam" type="text" description="Its name, which another of its virtual machine&#8217;s snapshots can share. Setting it renames it.">
				<cocoa key="name"/>
			</property>
			<property name="notes" code="KvNo" type="text" description="The user&#8217;s note on it, empty when there is none. Setting it replaces the note, trimmed of leading and trailing spaces and line breaks; empty text clears it.">
				<cocoa key="notes"/>
			</property>
			<property name="kind" code="KvKd" type="snapshot kind" access="r" description="What it captured.">
				<cocoa key="kind"/>
			</property>
			<property name="creation date" code="ascd" type="date" access="r" description="When it was taken.">
				<cocoa key="creationDate"/>
			</property>
			<property name="current" code="KvCu" type="boolean" access="r" description="Whether its virtual machine&#8217;s state descends from it.">
				<cocoa key="current"/>
			</property>
			<property name="ephemeral baseline" code="KvEb" type="boolean" access="r" description="Whether it is the snapshot its virtual machine returns to at every shutdown in Ephemeral Mode. Deleting it is refused while it is.">
				<cocoa key="ephemeralBaseline"/>
			</property>
			<property name="size" code="ptsz" type="real" access="r" description="What its files take on their volume, space they share with other files included, in gigabytes of 10^9 bytes, or missing value when they can&#8217;t be read.">
				<cocoa key="size"/>
			</property>
			<property name="private size" code="KvPz" type="real" access="r" description="The part of its size no other file shares, the space freed once it is deleted and the Trash is emptied, in gigabytes of 10^9 bytes; missing value on a volume that can&#8217;t clone files, where size is that space, or when its files can&#8217;t be read.">
				<cocoa key="privateSize"/>
			</property>
		</class>

		<class name="guest agent" code="KvGA" plural="guest agents" description="A Kernova guest agent in a virtual machine&#8217;s guest.">
			<cocoa class="VMGuestAgentScriptObject"/>
			<property name="role" code="KvRl" type="text" access="r" description="session for a session agent, which runs for one user, or system for the system service.">
				<cocoa key="role"/>
			</property>
			<property name="user" code="KvUr" type="text" access="r" description="The user a session agent runs for, or missing value for the system service or a session agent that names none.">
				<cocoa key="user"/>
			</property>
			<property name="status" code="KvSu" type="text" access="r" description="How it stands, in the terms agent status uses: current, connected, outdated, updating or unresponsive while connected; updating while it relaunches into an update and connecting while it is otherwise away; expectedMissing when it didn&#8217;t reconnect, and disconnected when it left and its wait passed.">
				<cocoa key="status"/>
			</property>
			<property name="version" code="vers" type="text" access="r" description="The version it reports, or last reported while away, empty when it reports none.">
				<cocoa key="version"/>
			</property>
		</class>

		<class name="storage disk" code="KvSD" plural="storage disks" description="A disk a virtual machine attaches. Its sizes are measured from its image file each time a script reads them.">
			<cocoa class="VMStorageDiskScriptObject"/>
			<property name="id" code="ID  " type="text" access="r" description="Its stable identifier, which a storage disk edit names it by.">
				<cocoa key="uniqueID"/>
			</property>
			<property name="name" code="pnam" type="text" access="r" description="Its label.">
				<cocoa key="name"/>
			</property>
			<property name="kind" code="KvKd" type="storage disk kind" access="r" description="The bus the guest sees it on.">
				<cocoa key="kind"/>
			</property>
			<property name="read only" code="KvRo" type="boolean" access="r" description="Whether the guest may read it but not write to it.">
				<cocoa key="readOnly"/>
			</property>
			<property name="path" code="KvPa" type="text" access="r" description="Its image file, as this Mac names it.">
				<cocoa key="path"/>
			</property>
			<property name="notes" code="KvNo" type="text" access="r" description="The user&#8217;s note on it, empty when there is none.">
				<cocoa key="notes"/>
			</property>
			<property name="capacity" code="KvCa" type="real" access="r" description="Its size as the guest sees it, in gigabytes of 10^9 bytes, or missing value when its image can&#8217;t be read.">
				<cocoa key="capacity"/>
			</property>
			<property name="used space" code="KvUs" type="real" access="r" description="What its image takes on its volume, in gigabytes of 10^9 bytes, or missing value when its image can&#8217;t be read.">
				<cocoa key="usedSpace"/>
			</property>
		</class>

		<class name="network" code="KvNw" plural="networks" description="A named network: the virtual machines on it reach each other, and no other guest. Make one with make new network with properties {name:…, kind:…}, a NAT network unless kind names another. Deleting one is refused while a virtual machine is set to join it; changing that machine&#8217;s setting &quot;network.membership&quot; to &quot;isolated&quot; moves it to a network of its own.">
			<cocoa class="VMNetworkScriptObject"/>
			<property name="id" code="ID  " type="text" access="r" description="Its stable identifier, which a virtual machine's network membership names.">
				<cocoa key="uniqueID"/>
			</property>
			<property name="name" code="pnam" type="text" description="Its name, unique in the library ignoring case.">
				<cocoa key="name"/>
			</property>
			<property name="kind" code="KvKd" type="network kind" access="r" description="The mode every virtual machine on it runs in, fixed when it is made.">
				<cocoa key="kind"/>
			</property>
			<element type="virtual machine" access="r" description="The virtual machines that join it.">
				<cocoa key="virtualMachines"/>
			</element>
		</class>

		<class name="smart group" code="KvGS" plural="smart groups" description="A saved library filter, listed as a section of the sidebar: its virtual machines are the ones the filter admits as a script reads them. A smart group and a folder can share a name. Start, suspend, stop or restart one to do what its Start All, Suspend All, Stop All or Restart All does. A script can&#8217;t make, rename or delete one, or change its filter.">
			<cocoa class="VMSmartGroupScriptObject"/>
			<property name="id" code="ID  " type="text" access="r" description="Its stable identifier.">
				<cocoa key="uniqueID"/>
			</property>
			<property name="name" code="pnam" type="text" access="r" description="Its name, unique among smart groups ignoring case.">
				<cocoa key="name"/>
			</property>
			<element type="virtual machine" access="r" description="The virtual machines its filter admits, in library order. Several can share a name: virtual machine &#8220;&#8230;&#8221; of a smart group refuses one more than one of them carries, listing their ids.">
				<cocoa key="virtualMachines"/>
			</element>
		</class>

		<class name="folder" code="KvGF" plural="folders" description="A collection of virtual machines put in it by hand, listed as a section of the sidebar. A smart group and a folder can share a name. Start, suspend, stop or restart one to do what its Start All, Suspend All, Stop All or Restart All does. A script can&#8217;t make, rename or delete one, or change what it holds.">
			<cocoa class="VMFolderScriptObject"/>
			<property name="id" code="ID  " type="text" access="r" description="Its stable identifier.">
				<cocoa key="uniqueID"/>
			</property>
			<property name="name" code="pnam" type="text" access="r" description="Its name, unique among folders ignoring case.">
				<cocoa key="name"/>
			</property>
			<element type="virtual machine" access="r" description="The virtual machines in it, in its own order. Several can share a name: virtual machine &#8220;&#8230;&#8221; of a folder refuses one more than one of them carries, listing their ids.">
				<cocoa key="virtualMachines"/>
			</element>
		</class>

		<class name="shared directory" code="KvSh" plural="shared directories" description="A folder on this Mac that a virtual machine shares with its guest. Share one with make new shared directory at a virtual machine with properties {path:&#8230;}, its full path, starting with / or ~/, and read only:true to keep the guest from writing to it; a folder the virtual machine already shares is left as it is. Kernova asks for a folder it can&#8217;t already read in an open panel, which comes in front once the script has told Kernova to activate, and shares the folder chosen there; AppleScript stops waiting for an answer after two minutes unless a with timeout block gives it longer, and the panel stays up in Kernova. Deleting one stops sharing its folder, which stays where it is.">
			<cocoa class="VMSharedDirectoryScriptObject"/>
			<property name="name" code="pnam" type="text" access="r" description="The folder&#8217;s own name, as the Sharing settings list it.">
				<cocoa key="name"/>
			</property>
			<property name="path" code="KvPa" type="text" access="r" description="The folder, as this Mac names it.">
				<cocoa key="path"/>
			</property>
			<property name="read only" code="KvRo" type="boolean" access="r" description="Whether the guest may read the folder but not write to it.">
				<cocoa key="readOnly"/>
			</property>
		</class>

		<class name="USB accessory" code="KvUA" plural="USB accessories" description="A USB accessory you&#8217;ve assigned to Kernova in macOS&#8217;s Virtual Machine Accessories menu extra: one of the application&#8217;s while no virtual machine holds it, and one of a virtual machine&#8217;s while its guest does. Attach one of the application&#8217;s to a running virtual machine, and detach one of a virtual machine&#8217;s. USB accessory passthrough needs macOS 27 or later.">
			<cocoa class="VMUSBAccessoryScriptObject"/>
			<property name="id" code="ID  " type="text" access="r" description="Its identifier, which lasts until it is unplugged or detached.">
				<cocoa key="uniqueID"/>
			</property>
			<property name="name" code="pnam" type="text" access="r" description="What the accessory calls itself, qualified by its port where two accessories would read alike.">
				<cocoa key="name"/>
			</property>
			<property name="vendor ID" code="KvVd" type="integer" access="r" description="The vendor identifier its device descriptor reports.">
				<cocoa key="vendorID"/>
			</property>
			<property name="product ID" code="KvPd" type="integer" access="r" description="The product identifier its device descriptor reports.">
				<cocoa key="productID"/>
			</property>
			<property name="key" code="KvKy" type="text" access="r" description="What Kernova recognizes it by across a replug and a restart, the key a remembered USB accessory carries; missing value when it reports nothing Kernova can recognize it by.">
				<cocoa key="key"/>
			</property>
		</class>

		<class name="remembered USB accessory" code="KvRA" plural="remembered USB accessories" description="A USB accessory a virtual machine takes back automatically whenever both are available, plugged in or not. Attaching an accessory remembers it, and detaching it or deleting this forgets it. USB accessory passthrough needs macOS 27 or later.">
			<cocoa class="VMRememberedUSBAccessoryScriptObject"/>
			<property name="name" code="pnam" type="text" access="r" description="What the accessory is called, qualified by its port when Kernova recognizes it by the port it&#8217;s plugged into.">
				<cocoa key="name"/>
			</property>
			<property name="key" code="KvKy" type="text" access="r" description="What Kernova recognizes it by, the key a USB accessory carries while it is plugged in.">
				<cocoa key="key"/>
			</property>
			<property name="date remembered" code="KvRd" type="date" access="r" description="When an attach someone asked for last remembered it; Kernova passing it through again on its own leaves this as it is.">
				<cocoa key="dateRemembered"/>
			</property>
		</class>

		<command name="start" code="KrnvStrt" description="Start a virtual machine, running whatever guest setup it still owes first. Wrap a long wait in a with timeout block: AppleScript gives up on a reply after two minutes by default, and the command goes on in Kernova. Given several virtual machines, it takes them in turn and ends at the first one refused, leaving those before it started. Given a smart group or folder, it starts, restores or resumes each virtual machine in it whose state takes it, one after another, as Start All does, asking nothing, passing over one whose start would set up its guest, and taking no recovery mode or confirmation. One whose own start would ask something first, or fails, is left undone while the start goes on to the next; once each has had its turn, it errors with a line for each one left undone, and what it did to the others stands.">
			<cocoa class="VMStartScriptCommand"/>
			<direct-parameter description="The virtual machine to start, a list of them, or a smart group or folder.">
				<type type="virtual machine"/>
				<type type="virtual machine" list="yes"/>
				<type type="smart group"/>
				<type type="folder"/>
			</direct-parameter>
			<parameter name="recovery mode" code="Kprc" type="boolean" optional="yes" description="Cold-boot a stopped macOS guest into macOS Recovery.">
				<cocoa key="RecoveryMode"/>
			</parameter>
			<parameter name="confirmation" code="Kpcf" type="boolean" optional="yes" description="Start it beside an active virtual machine with the same machine ID, where Kernova’s Settings allow starting one anyway.">
				<cocoa key="Confirmation"/>
			</parameter>
			<result description="The virtual machines it acted on, each as virtual machine id &#8220;&#8230;&#8221;: a reference for a reference to one virtual machine, and a list, in order, for a list of them, a reference to several, or a smart group or folder &#8212; for a group, those it started, restored or resumed.">
				<type type="specifier"/>
				<type type="specifier" list="yes"/>
			</result>
		</command>

		<command name="stop" code="KrnvStop" description="Stop a virtual machine. Wrap a long wait in a with timeout block: AppleScript gives up on a reply after two minutes by default, and the command goes on in Kernova. Given several virtual machines, it takes them in turn and ends at the first one refused, leaving those before it stopped. Given a smart group or folder, it asks each running guest in it to shut down, one after another, as Stop All does, asking nothing, passing over a paused or suspended one, and taking no method but normal, and no confirmation or giving up after. One whose own stop would ask something first, or fails, is left undone while the stop goes on to the next; once each has had its turn, it errors with a line for each one left undone, and what it did to the others stands.">
			<cocoa class="VMStopScriptCommand"/>
			<direct-parameter description="The virtual machine to stop, a list of them, or a smart group or folder.">
				<type type="virtual machine"/>
				<type type="virtual machine" list="yes"/>
				<type type="smart group"/>
				<type type="folder"/>
			</direct-parameter>
			<parameter name="method" code="KpSm" type="VM stop method" optional="yes" description="How to reach a powered-off guest; normal by default.">
				<cocoa key="StopMethod"/>
			</parameter>
			<parameter name="confirmation" code="Kpcf" type="boolean" optional="yes" description="Supply the consent a destructive stop refuses without.">
				<cocoa key="Confirmation"/>
			</parameter>
			<parameter name="giving up after" code="givu" type="integer" optional="yes" description="Seconds to wait for the guest to power off before giving up and leaving it as it was.">
				<cocoa key="GivingUpAfter"/>
			</parameter>
			<result description="The virtual machines it acted on, each as virtual machine id &#8220;&#8230;&#8221;: a reference for a reference to one virtual machine, and a list, in order, for a list of them, a reference to several, or a smart group or folder &#8212; for a group, those it asked to shut down.">
				<type type="specifier"/>
				<type type="specifier" list="yes"/>
			</result>
		</command>

		<command name="restart" code="KrnvRstr" description="Shut a virtual machine's guest down and start it again. Wrap a long wait in a with timeout block: AppleScript gives up on a reply after two minutes by default, and the command goes on in Kernova. Given several virtual machines, it takes them in turn and ends at the first one refused, leaving those before it restarted. Given a smart group or folder, it restarts every running guest in it at once, as Restart All does, asking nothing, passing over a paused or suspended one, and taking no method but normal, and no confirmation or giving up after. One whose own restart would ask something first, or fails, is left undone while the others restart; once each is back up or has failed, it errors with a line for each one left undone, and what it did to the others stands.">
			<cocoa class="VMRestartScriptCommand"/>
			<direct-parameter description="The virtual machine to restart, a list of them, or a smart group or folder.">
				<type type="virtual machine"/>
				<type type="virtual machine" list="yes"/>
				<type type="smart group"/>
				<type type="folder"/>
			</direct-parameter>
			<parameter name="method" code="KpSm" type="VM stop method" optional="yes" description="How to take the guest down before starting it again; normal by default.">
				<cocoa key="StopMethod"/>
			</parameter>
			<parameter name="confirmation" code="Kpcf" type="boolean" optional="yes" description="Supply the consent a destructive restart refuses without, and start it again beside an active virtual machine with the same machine ID, where Kernova’s Settings allow starting one anyway.">
				<cocoa key="Confirmation"/>
			</parameter>
			<parameter name="giving up after" code="givu" type="integer" optional="yes" description="Seconds to wait for the guest to power off before giving up and starting nothing.">
				<cocoa key="GivingUpAfter"/>
			</parameter>
			<result description="The virtual machines it acted on, each as virtual machine id &#8220;&#8230;&#8221;: a reference for a reference to one virtual machine, and a list, in order, for a list of them, a reference to several, or a smart group or folder &#8212; for a group, those it restarted.">
				<type type="specifier"/>
				<type type="specifier" list="yes"/>
			</result>
		</command>

		<command name="pause" code="KrnvPaus" description="Freeze a running guest in memory.">
			<cocoa class="VMPauseScriptCommand"/>
			<direct-parameter description="The virtual machine to pause, or a list of them.">
				<type type="virtual machine"/>
				<type type="virtual machine" list="yes"/>
			</direct-parameter>
		</command>

		<command name="resume" code="KrnvResu" description="Run a paused guest again, or read a suspended session back.">
			<cocoa class="VMResumeScriptCommand"/>
			<direct-parameter description="The virtual machine to resume, or a list of them.">
				<type type="virtual machine"/>
				<type type="virtual machine" list="yes"/>
			</direct-parameter>
			<parameter name="confirmation" code="Kpcf" type="boolean" optional="yes" description="Resume it beside an active virtual machine with the same machine ID, where Kernova’s Settings allow starting one anyway.">
				<cocoa key="Confirmation"/>
			</parameter>
		</command>

		<command name="suspend" code="KrnvSusp" description="Save the guest's state to the bundle's suspend slot and stop running it. Wrap a long wait in a with timeout block: AppleScript gives up on a reply after two minutes by default, and the command goes on in Kernova. Given several virtual machines, it takes them in turn and ends at the first one refused, leaving those before it suspended. Given a smart group or folder, it suspends each running or paused guest in it, one after another, as Suspend All does, asking nothing. One whose own suspend would ask something first, or fails, is left undone while the suspend goes on to the next; once each has had its turn, it errors with a line for each one left undone, and what it did to the others stands.">
			<cocoa class="VMSuspendScriptCommand"/>
			<direct-parameter description="The virtual machine to suspend, a list of them, or a smart group or folder.">
				<type type="virtual machine"/>
				<type type="virtual machine" list="yes"/>
				<type type="smart group"/>
				<type type="folder"/>
			</direct-parameter>
			<result description="The virtual machines it acted on, each as virtual machine id &#8220;&#8230;&#8221;: a reference for a reference to one virtual machine, and a list, in order, for a list of them, a reference to several, or a smart group or folder &#8212; for a group, those it suspended.">
				<type type="specifier"/>
				<type type="specifier" list="yes"/>
			</result>
		</command>

		<command name="reveal" code="KrnvRevl" description="Bring a virtual machine in front of the user, whatever state it is in.">
			<cocoa class="VMRevealScriptCommand"/>
			<direct-parameter description="The virtual machine to reveal, or a list of them.">
				<type type="virtual machine"/>
				<type type="virtual machine" list="yes"/>
			</direct-parameter>
		</command>

		<command name="revert to" code="KrnvRvrt" description="Return a snapshot&#8217;s virtual machine to it.">
			<cocoa class="VMRevertScriptCommand"/>
			<direct-parameter description="The snapshot to revert its virtual machine to, or a list of them.">
				<type type="snapshot"/>
				<type type="snapshot" list="yes"/>
			</direct-parameter>
			<parameter name="confirmation" code="Kpcf" type="boolean" optional="yes" description="Supply the consent a revert refuses without, running the virtual machine beside an active one with the same machine ID included, where Kernova&#8217;s Settings allow starting one anyway.">
				<cocoa key="Confirmation"/>
			</parameter>
		</command>

		<command name="change" code="KrnvChng" description="Change one or more settings, as set value of setting does, with the consent set can&#8217;t give: with confirmation. The settings of one virtual machine change together or not at all; those of several virtual machines change one virtual machine at a time, stopping at the first one refused and leaving those before it changed.">
			<cocoa class="VMChangeScriptCommand"/>
			<direct-parameter description="The setting to change, or a list of them.">
				<type type="setting"/>
				<type type="setting" list="yes"/>
			</direct-parameter>
			<parameter name="to" code="data" type="any" description="The value, as a setting&#8217;s value takes it, or a list of them, one for each setting in the order named.">
				<cocoa key="Value"/>
			</parameter>
			<parameter name="confirmation" code="Kpcf" type="boolean" optional="yes" description="Supply the consent a change refuses without: turning on Ephemeral Mode or changing its baseline, and turning on automatic clipboard passthrough.">
				<cocoa key="Confirmation"/>
			</parameter>
			<result type="any" description="The value each setting holds afterwards, or a list of them for several, which can differ from the one given: network.mac set to &quot;new&quot; answers the address it got."/>
		</command>

		<command name="cancel guest setup" code="KrnvCnGs" description="Interrupt the download, verification or install a virtual machine&#8217;s first start is running. The virtual machine and its bundle are kept, and its next start begins its guest setup again.">
			<cocoa class="VMCancelGuestSetupScriptCommand"/>
			<direct-parameter description="The virtual machine whose guest setup to cancel, or a list of them.">
				<type type="virtual machine"/>
				<type type="virtual machine" list="yes"/>
			</direct-parameter>
			<parameter name="confirmation" code="Kpcf" type="boolean" optional="yes" description="Supply the consent cancelling a guest setup refuses without.">
				<cocoa key="Confirmation"/>
			</parameter>
		</command>

		<command name="import" code="KrnvImpt" description="Copy a virtual machine bundle into the library, leaving the original where it is, and answer the imported virtual machine once its copy has finished; a bundle already in the library answers the virtual machine it is. Kernova asks for a bundle it can&#8217;t already read in an open panel, which comes in front once the script has told Kernova to activate. AppleScript stops waiting for an answer after two minutes unless a with timeout block gives it longer, and the import goes on in Kernova.">
			<cocoa class="VMImportScriptCommand"/>
			<direct-parameter description="The bundle, as a file or as its full path, starting with / or ~/.">
				<type type="file"/>
				<type type="text"/>
			</direct-parameter>
			<parameter name="waiting" code="KpWt" type="boolean" optional="yes" description="Wait for the copy to finish before answering, as by default; without waiting answers the new virtual machine while its copy is still being written.">
				<cocoa key="Waiting"/>
			</parameter>
			<result type="specifier" description="The imported virtual machine."/>
		</command>

		<command name="attach" code="KrnvAtch" description="Pass a USB accessory through to a running virtual machine&#8217;s guest, and remember it there: the virtual machine takes it back automatically whenever both are available, unless the accessory reports nothing Kernova can recognize it by. It takes the application&#8217;s USB accessories, the ones no virtual machine holds. Given several, it attaches them in turn and ends at the first one refused, leaving those before it attached. USB accessory passthrough needs macOS 27 or later.">
			<cocoa class="VMAttachScriptCommand"/>
			<direct-parameter description="The USB accessory to attach, or a list of them.">
				<type type="USB accessory"/>
				<type type="USB accessory" list="yes"/>
			</direct-parameter>
			<parameter name="to" code="KpTo" type="virtual machine" description="The running virtual machine to attach it to.">
				<cocoa key="Target"/>
			</parameter>
		</command>

		<command name="detach" code="KrnvDtch" description="Take a USB accessory back off a running virtual machine&#8217;s guest, and forget it there: the virtual machine no longer takes it back automatically. It takes a virtual machine&#8217;s USB accessories, which return to the application&#8217;s, under a new id. Given several, it detaches them in turn and ends at the first one refused, leaving those before it detached. USB accessory passthrough needs macOS 27 or later.">
			<cocoa class="VMDetachScriptCommand"/>
			<direct-parameter description="The USB accessory to detach, or a list of them.">
				<type type="USB accessory"/>
				<type type="USB accessory" list="yes"/>
			</direct-parameter>
		</command>

		<command name="cancel copy" code="KrnvCnCp" description="Stop a new virtual machine that a duplicate, import or create is still writing, one whose state is preparing, and remove what it has written. A virtual machine whose copy has finished refuses, as does the one a clone is copied from.">
			<cocoa class="VMCancelCopyScriptCommand"/>
			<direct-parameter description="The virtual machine still being written, or a list of them.">
				<type type="virtual machine"/>
				<type type="virtual machine" list="yes"/>
			</direct-parameter>
			<parameter name="confirmation" code="Kpcf" type="boolean" optional="yes" description="Supply the consent cancelling a copy refuses without.">
				<cocoa key="Confirmation"/>
			</parameter>
		</command>

	</suite>

</dictionary>
