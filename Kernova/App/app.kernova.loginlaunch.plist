<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>app.kernova.loginlaunch</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>app.kernova</string>
	</array>
	<!-- launchd.plist(5): BundleProgram is execv(3)'s path argument, resolved
	     against the app bundle and supported only for plists registered through
	     SMAppService; ProgramArguments is the argv vector, so its first element
	     is argv[0] rather than the program to run. -->
	<key>BundleProgram</key>
	<string>Contents/MacOS/Kernova</string>
	<key>ProgramArguments</key>
	<array>
		<string>Contents/MacOS/Kernova</string>
		<string>--login-launch</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
</dict>
</plist>
