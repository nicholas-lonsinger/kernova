pinned peer  fixture=macos-system-ignore-apps-v1
current host fixture=host-default token=000102030405060708090a0b0c0d0e0f
end 2000
t=0      expect  h>p preamble
t=0      expect  h>p s=0 MSG hello role=1 scope=0 token=000102030405060708090a0b0c0d0e0f 1=v1:actions[]:asks=false 2=v1:formats[]
t=0      p>h     4b524e32
t=0      p>h     00000000 00 01 000000a4 
