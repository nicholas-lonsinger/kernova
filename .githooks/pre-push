#!/usr/bin/env bash
#
# Run `make lint` before pushing. Mirrors the required `lint` check that runs
# in CI (.github/workflows/lint.yml) so formatting and shell-lint failures are
# caught locally instead of on the PR. Bypass with `git push --no-verify`.

set -euo pipefail

# Skip when nothing real is being pushed (e.g. branch deletion: local sha
# is all zeros). Each stdin line is: <local-ref> <local-sha> <remote-ref> <remote-sha>.
# Glob match is hash-agnostic so this works for both SHA-1 (40 chars) and
# SHA-256 (64 chars) repositories.
has_work=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    if [[ "$local_sha" == *[!0]* ]]; then
        has_work=1
        break
    fi
done

if [ "$has_work" -eq 0 ]; then
    exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "pre-push: running 'make lint' (bypass with git push --no-verify)"

# Don't attribute the failure to swift-format: `make lint` covers the shell
# scripts too, and a shellcheck or `bash -n` finding sent the reader to
# `make format`, which cannot fix one. Name both remedies and let the output
# above say which applies.
if ! make lint; then
    echo ""
    echo "pre-push: 'make lint' failed — see the findings above."
    echo "          Swift findings:  run 'make format' to auto-fix, then commit and push again."
    echo "          Shell findings:  fix by hand; swift-format does not touch shell scripts."
    exit 1
fi
