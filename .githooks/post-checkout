#!/usr/bin/env bash
#
# Runs Tools/worktree-setup.sh on every branch checkout. The script sets a
# checkout up once and returns immediately after that, so this covers a
# fresh `git worktree add` and lets a worktree that predates
# `make install-hooks` catch up on its next `git switch`. Hooks activate only
# once `make install-hooks` sets core.hooksPath (git never auto-runs
# checked-in hooks) — see README "Building Kernova".
#
# Git runs post-checkout from the working-tree root, so the relative path
# below resolves within whichever worktree was just created or switched.

set -uo pipefail

# $3 is 1 for a branch checkout, 0 for a file checkout (git checkout -- <path>),
# which creates no working tree.
[ "${3:-0}" = "1" ] || exit 0

# Git exports GIT_DIR and its companions to a hook (githooks(5)), and they
# outrank `-C` and a directory's own .git for every git and SwiftPM call below.
# shellcheck disable=SC2046 # one variable name per word
unset $(git rev-parse --local-env-vars)

# Best-effort: a failed setup must not fail the checkout.
if [ -x Tools/worktree-setup.sh ]; then
    Tools/worktree-setup.sh || true
fi

exit 0
