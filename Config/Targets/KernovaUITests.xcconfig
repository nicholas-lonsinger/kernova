// The KernovaUITests bundle, both configurations: KernovaCore's KernovaUI
// target, tested inside KernovaTestHost.
//
// The bundle links the code under test itself and the host links none of it,
// so BUNDLE_LOADER stays empty and the test process holds one copy.
//
// No signing identity or team is assigned here: a target xcconfig outranks
// Config/Local.xcconfig, and host and test bundle must sign together.

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = app.kernova.uitests
MARKETING_VERSION = $(KERNOVA_MARKETING_VERSION)

// The generated Info.plist takes its CFBundleVersion from here.
GENERATE_INFOPLIST_FILE = YES
CURRENT_PROJECT_VERSION = 1

TEST_HOST = $(BUILT_PRODUCTS_DIR)/KernovaTestHost.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/KernovaTestHost
BUNDLE_LOADER =
SWIFT_EMIT_LOC_STRINGS = NO

// As in Kernova.xcconfig: KernovaCore's package identity.
SWIFT_PACKAGE_NAME = kernovacore

CODE_SIGN_STYLE = Automatic
