// The Kernova app target, both configurations.
//
// No signing identity or team is assigned here: a target xcconfig outranks
// Config/Local.xcconfig, so an assignment would silently revert a developer to
// ad-hoc signing.

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = app.kernova
MARKETING_VERSION = $(KERNOVA_MARKETING_VERSION)

// CFBundleVersion comes from Tools/set-build-number.sh through the prefix
// header, so the checked-in Info.plist is preprocessed rather than generated.
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Kernova/App/Info.plist
INFOPLIST_PREPROCESS = YES
INFOPLIST_PREFIX_HEADER = $(DERIVED_FILE_DIR)/KernovaBuildNumber.h

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
COMBINE_HIDPI_IMAGES = YES
SWIFT_EMIT_LOC_STRINGS = YES

// KernovaCore's package identity, which opens its `package` declarations to
// this module. A module belongs to exactly one package.
SWIFT_PACKAGE_NAME = kernovacore
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks

CODE_SIGN_STYLE = Automatic
// Debug reads a project-layer variable Config/Local.xcconfig can set. Release,
// which Archive builds, names the full set at this layer, out of
// Local.xcconfig's reach: an archive carries every restricted key or fails to
// sign.
CODE_SIGN_ENTITLEMENTS[config=Debug] = $(KERNOVA_DEBUG_APP_ENTITLEMENTS)
CODE_SIGN_ENTITLEMENTS[config=Release] = Kernova/Resources/Kernova.entitlements
PROVISIONING_PROFILE_SPECIFIER =
ENABLE_HARDENED_RUNTIME[config=Release] = YES
