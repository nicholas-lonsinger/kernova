// The KernovaTests bundle, both configurations.
//
// No signing identity or team is assigned here: a target xcconfig outranks
// Config/Local.xcconfig, and a team-signed hardened test host rejects an
// ad-hoc test bundle under library validation, so host and bundle must sign
// together — docs/BUILD.md "Signing identity".

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = app.kernova.tests
MARKETING_VERSION = $(KERNOVA_MARKETING_VERSION)

// The generated Info.plist takes its CFBundleVersion from here.
GENERATE_INFOPLIST_FILE = YES
CURRENT_PROJECT_VERSION = 1

TEST_HOST = $(BUILT_PRODUCTS_DIR)/Kernova.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Kernova
BUNDLE_LOADER = $(TEST_HOST)
SWIFT_EMIT_LOC_STRINGS = NO

CODE_SIGN_STYLE = Automatic
