// The `kernova` command-line tool, both configurations.
//
// Modeled on KernovaRelaunchHelper.xcconfig; like it, this names no signing
// identity outside the Release `-` pin, so Config/Local.xcconfig still reaches
// the target.

// Embedded at Contents/Helpers/kernova, never Contents/MacOS: the volume is
// case-insensitive, so there `kernova` is the app's own `Kernova` — the copy
// overwrote the app executable and the app's signing pass gave the tool the
// full entitlement set (observed 2026-09-05: one inode under both names).
PRODUCT_NAME = kernova
PRODUCT_MODULE_NAME = KernovaCLI
PRODUCT_BUNDLE_IDENTIFIER = app.kernova.cli
MARKETING_VERSION = $(KERNOVA_MARKETING_VERSION)
CURRENT_PROJECT_VERSION = 1

// A sandboxed standalone executable needs a CFBundleIdentifier in its own
// signature or secinitd kills it before main —
// docs/research/2026-09-05-cli-transport-launchd-domains-and-sandboxed-sockets.md.
GENERATE_INFOPLIST_FILE = YES
CREATE_INFOPLIST_SECTION_IN_BINARY = YES

CODE_SIGN_STYLE = Automatic
// A build with no team signs the tool with no entitlements. Sandboxed, the
// tool's launch asks containermanagerd for its containers before main, and on
// a Mac where a team-signed build ran it first that raises "differs from
// previously opened versions" and waits for an answer (observed 2026-11-06,
// macOS 27.2); a team-less signature is granted no app group either way.
KERNOVA_CLI_TEAMLESS_ = YES
KERNOVA_CLI_ENTITLEMENTS_TEAMLESS_ = KernovaCLI/KernovaCLI.entitlements
KERNOVA_CLI_ENTITLEMENTS_TEAMLESS_YES =
CODE_SIGN_ENTITLEMENTS = $(KERNOVA_CLI_ENTITLEMENTS_TEAMLESS_$(KERNOVA_CLI_TEAMLESS_$(DEVELOPMENT_TEAM)))
PROVISIONING_PROFILE_SPECIFIER =

CODE_SIGN_IDENTITY[sdk=macosx*][config=Release] = -
ENABLE_HARDENED_RUNTIME[config=Release] = YES
SKIP_INSTALL[config=Release] = YES
